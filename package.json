{
  "name": "@mobile-observability/cli",
  "version": "0.1.0",
  "description": "mobs — upload source maps for mobile-observability (EAS Update and native builds). Works in Expo and bare React Native projects.",
  "keywords": [
    "react-native",
    "expo",
    "eas-update",
    "source-maps",
    "sourcemaps",
    "hermes",
    "symbolication",
    "crash-reporting",
    "observability",
    "cli"
  ],
  "license": "MIT",
  "author": "mobile-observability",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmadal/mobs.git"
  },
  "homepage": "https://github.com/emmadal/mobs#readme",
  "bugs": "https://github.com/emmadal/mobs/issues",
  "bin": {
    "mobs": "build/mobs.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && node build/mobs.js --version"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
